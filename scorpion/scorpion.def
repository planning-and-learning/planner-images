# One Scorpion image for every configuration: the planner options follow
# DOMAIN TASK PLAN at run time (see README.md and configs.json).
#
# Stage 1: compile Scorpion. With --build-arg CPLEX_DIR=<cplex> it links CPLEX
# (LP configurations work; the image contains CPLEX and must not be shared);
# without it there is no LP solver and the image can be shared.
Bootstrap: docker
From: ubuntu:24.04
Stage: build

%arguments
    CPLEX_DIR=none

# %setup runs on the host, so CPLEX is copied only when CPLEX_DIR is given:
# headers and static libraries, linked into the binary.
%setup
    rootfs="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    cplex_dir="{{ CPLEX_DIR }}"
    if [ "$cplex_dir" != none ]; then
        if [ ! -d "$cplex_dir/include" ] || [ ! -d "$cplex_dir/lib" ]; then
            echo "CPLEX_DIR=$cplex_dir has no include/ and lib/ directories." >&2
            exit 1
        fi
        mkdir -p "$rootfs/opt/cplex"
        cp -r "$cplex_dir/include" "$cplex_dir/lib" "$rootfs/opt/cplex/"
    fi

%files
    scorpion /planner

%post
    ## Install all necessary dependencies.
    apt-get update
    apt-get install --no-install-recommends -y \
        cmake \
        g++ \
        make \
        python3

    ## Build Scorpion, with CPLEX if it was copied in.
    cd /planner
    rm -rf builds
    if [ -d /opt/cplex ]; then
        export cplex_DIR=/opt/cplex
        lp_solver=cplex
    else
        lp_solver=none
    fi
    python3 build.py
    cache=builds/release/CMakeCache.txt
    if [ "$lp_solver" = cplex ]; then
        if ! grep -Eq '^CPLEX_LIBRARY_[A-Z]+:FILEPATH=/opt/cplex/lib/.*/libcplex\.a$' "$cache"; then
            echo "CPLEX was not linked; check CPLEX_DIR." >&2
            exit 1
        fi
    elif grep -Eq '^(CPLEX_LIBRARY_[A-Z]+:FILEPATH|soplex_DIR:PATH)=/' "$cache"; then
        echo "An LP solver was found although CPLEX_DIR was not given." >&2
        exit 1
    fi
    echo "$lp_solver" > /planner/LP_SOLVER
    strip --strip-all \
        builds/release/bin/downward \
        builds/release/bin/preprocess-h2 \
        builds/release/bin/translate-cpp


# Stage 2: run Scorpion.
Bootstrap: docker
From: ubuntu:24.04
Stage: run

%setup
    rootfs="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    if [ -n "$rootfs" ]; then
        mkdir -p "$rootfs/proj"
    fi

%files
    ../report-resources.py /report-resources.py
    run-scorpion.py /planner/run-scorpion.py
    configs.json /planner/configs.json

%files from build
    /planner/driver
    /planner/fast-downward.py
    /planner/builds/release/bin
    /planner/LP_SOLVER

%post
    apt-get update
    apt-get install --no-install-recommends -y pypy3 python3
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    chmod +x /planner/run-scorpion.py

%runscript
    exec python3 /report-resources.py python3 /planner/run-scorpion.py "$@"

%labels
Name        Scorpion
Description Scorpion (planning-and-learning/scorpion@e6f0520) for any configuration given at run time; LP solver chosen at build time (see /planner/LP_SOLVER)
Authors     Jendrik Seipp <jendrik.seipp@liu.se>
