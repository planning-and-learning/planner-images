Bootstrap: docker
From: python:3.13-slim

%setup
    rootfs="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    if [ -n "$rootfs" ]; then
        mkdir -p "$rootfs/proj"
    fi

%files
    ../report-resources.py /report-resources.py
    lifted-siwr.py /planner/lifted-siwr.py

%post
    apt-get update
    apt-get install --no-install-recommends -y ca-certificates
    python -m pip install --no-cache-dir --only-binary=:all: 'pyrunir==0.3.0'
    chmod +x /planner/lifted-siwr.py
    rm -rf /var/lib/apt/lists/*

%runscript
    #! /bin/bash
    set -euo pipefail
    exec python3 /report-resources.py /planner/lifted-siwr.py "$@"

%labels
Name        RunIR-Lifted-SIWR
Description Lifted SIWR sketch search implemented through the pyrunir Python bindings
Authors     Dominik Drexler <dominik.drexler@liu.se>
SupportsDerivedPredicates yes
SupportsQuantifiedPreconditions yes
SupportsQuantifiedEffects yes
