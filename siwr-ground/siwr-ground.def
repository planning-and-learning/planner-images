Bootstrap: docker
From: python:3.13-slim

%setup
    rootfs="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    if [ -n "$rootfs" ]; then
        mkdir -p "$rootfs/proj"
    fi

%files
    ground-siwr.py /planner/ground-siwr.py

%post
    apt-get update
    apt-get install --no-install-recommends -y ca-certificates
    python -m pip install --no-cache-dir 'pyrunir>=0.2.5,<0.3'
    chmod +x /planner/ground-siwr.py
    rm -rf /var/lib/apt/lists/*

%runscript
    #! /bin/bash
    set -euo pipefail
    exec /planner/ground-siwr.py "$@"

%labels
Name        RunIR-Ground-SIWR
Description Ground SIWR sketch search implemented through the pyrunir Python bindings
Authors     Dominik Drexler <dominik.drexler@liu.se>
SupportsDerivedPredicates yes
SupportsQuantifiedPreconditions yes
SupportsQuantifiedEffects yes
